// Mapped to the existing JustAclick tables. Queries use mysql2 until a live
// `prisma db pull` can be compared with this file. Do not rename columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String   @default("customer")
  phone         String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  image    String?
  isActive Int     @default(1) @map("is_active")

  @@map("categories")
}

model Product {
  id             Int      @id @default(autoincrement())
  categoryId     Int?     @map("category_id")
  name           String
  slug           String   @unique
  description    String?  @db.Text
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  stockQty       Int      @default(0) @map("stock_qty")
  sku            String?
  badge          String?
  gradeLabel     String?  @map("grade_label")
  isActive       Int      @default(1) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("products")
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  path      String
  sortOrder Int    @default(0) @map("sort_order")
  isPrimary Int    @default(0) @map("is_primary")

  @@map("product_images")
}

model Cart {
  id        Int     @id @default(autoincrement())
  userId    Int?    @unique @map("user_id")
  sessionId String? @unique @map("session_id")

  @@map("carts")
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int @map("cart_id")
  productId Int @map("product_id")
  qty       Int

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Wishlist {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  productId Int @map("product_id")

  @@unique([userId, productId])
  @@map("wishlists")
}

model Order {
  id            Int      @id @default(autoincrement())
  orderNumber   String   @unique @map("order_number")
  userId        Int      @map("user_id")
  status        String
  paymentMethod String   @map("payment_method")
  paymentStatus String   @map("payment_status")
  subtotal      Decimal  @db.Decimal(12, 2)
  shipping      Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  givenName     String   @map("given_name")
  familyName    String   @map("family_name")
  city          String
  postalCode    String   @map("postal_code")
  streetAddress String   @map("street_address")
  notes         String?  @db.Text
  stockDeducted Int      @default(0) @map("stock_deducted")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("orders")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int     @map("order_id")
  productId     Int     @map("product_id")
  nameSnapshot  String  @map("name_snapshot")
  priceSnapshot Decimal @map("price_snapshot") @db.Decimal(12, 2)
  qty           Int
  lineTotal     Decimal @map("line_total") @db.Decimal(12, 2)

  @@map("order_items")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique @map("order_id")
  invoiceNumber String   @unique @map("invoice_number")
  issuedAt      DateTime @default(now()) @map("issued_at")

  @@map("invoices")
}

model InventoryLog {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  changeQty Int      @map("change_qty")
  reason    String
  refId     Int?     @map("ref_id")
  createdBy Int?     @map("created_by")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("inventory_logs")
}
